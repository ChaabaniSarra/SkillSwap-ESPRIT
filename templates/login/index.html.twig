<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login · SkillWap Esprit</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* ----- RESET & BASE ----- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
            margin: 0;
            background: linear-gradient(135deg, #5a0808, #7a0c0c, #8f1111);
            min-height: 100vh;
            position: relative;
            overflow-x: hidden;
        }

        /* epic animated background particles */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: 
                radial-gradient(circle at 20% 80%, rgba(255, 255, 255, 0.05) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.03) 0%, transparent 50%);
            pointer-events: none;
            z-index: 0;
        }

        .login-page {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 40px 20px;
            position: relative;
            z-index: 1;
        }

        /* ----- MAIN CARD – glassmorphism + epic shadow ----- */
        .login-card {
            display: flex;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            max-width: 1000px;
            width: 100%;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 
                0 30px 80px rgba(0, 0, 0, 0.5),
                0 10px 30px rgba(122, 12, 12, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.15);
            transition: all 0.3s ease;
        }

        .login-card:hover {
            transform: translateY(-4px);
            box-shadow: 
                0 40px 100px rgba(0, 0, 0, 0.55),
                0 15px 40px rgba(122, 12, 12, 0.35);
        }

        /* ----- LEFT BANNER – enhanced with overlay & badge ----- */
        .login-banner {
            flex: 1;
            min-height: 580px;
            background: url('https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=2070&auto=format&fit=crop') center/cover no-repeat;
            position: relative;
            transition: all 0.4s ease;
        }

        .login-banner::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(122, 12, 12, 0.3), rgba(0, 0, 0, 0.3));
            z-index: 1;
        }

        .login-banner::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, transparent 40%, rgba(122, 12, 12, 0.4));
            z-index: 1;
        }

        .banner-content {
            position: absolute;
            bottom: 40px;
            left: 40px;
            z-index: 2;
            color: white;
        }

        .banner-content .brand {
            font-size: 28px;
            font-weight: 800;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
        }

        .banner-content .brand i {
            background: rgba(255, 255, 255, 0.2);
            padding: 10px;
            border-radius: 14px;
            font-size: 20px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .banner-content .brand span {
            color: #ffd700;
        }

        .banner-content p {
            font-size: 15px;
            opacity: 0.9;
            font-weight: 400;
            max-width: 280px;
            line-height: 1.5;
        }

        .banner-content .badge {
            display: inline-block;
            background: rgba(255, 215, 0, 0.2);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 215, 0, 0.2);
            padding: 6px 18px;
            border-radius: 60px;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            margin-bottom: 16px;
        }

        /* ----- RIGHT FORM SIDE – enhanced ----- */
        .login-form-side {
            flex: 1;
            padding: 60px 50px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background: rgba(255, 255, 255, 0.98);
        }

        .login-form-side .form-header {
            margin-bottom: 40px;
        }

        .login-form-side .form-header h1 {
            font-size: 36px;
            font-weight: 800;
            color: #0b1a2a;
            letter-spacing: -0.5px;
            margin-bottom: 6px;
        }

        .login-form-side .form-header p {
            color: #5a6f80;
            font-size: 15px;
        }

        .login-form-side .form-header p a {
            color: #7a0c0c;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .login-form-side .form-header p a:hover {
            text-decoration: underline;
        }

        /* enhanced form groups */
        .form-group {
            margin-bottom: 28px;
            position: relative;
        }

        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #2d3f4f;
            margin-bottom: 6px;
            letter-spacing: 0.3px;
        }

        .form-group .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
            border-bottom: 2px solid #dce3ea;
            transition: all 0.3s ease;
            padding: 4px 0;
        }

        .form-group .input-wrapper:focus-within {
            border-bottom-color: #7a0c0c;
            transform: translateY(-1px);
        }

        .form-group .input-wrapper i {
            color: #7a8b9c;
            font-size: 18px;
            margin-right: 12px;
            transition: all 0.3s ease;
            min-width: 20px;
        }

        .form-group .input-wrapper:focus-within i {
            color: #7a0c0c;
        }

        .form-group input {
            width: 100%;
            border: none;
            padding: 10px 2px;
            font-size: 16px;
            outline: none;
            background: transparent;
            font-weight: 500;
            color: #0b1a2a;
            font-family: inherit;
        }

        .form-group input::placeholder {
            color: #98aec0;
            font-weight: 400;
            font-size: 15px;
        }

        .form-group .input-wrapper .toggle-password {
            cursor: pointer;
            color: #98aec0;
            font-size: 16px;
            transition: all 0.3s ease;
            padding: 4px;
        }

        .form-group .input-wrapper .toggle-password:hover {
            color: #7a0c0c;
        }

        /* enhanced button */
        .btn-login {
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, #7a0c0c, #a31515);
            border: none;
            border-radius: 12px;
            font-weight: 700;
            font-size: 16px;
            color: #fff;
            cursor: pointer;
            margin-top: 10px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 20px rgba(122, 12, 12, 0.35);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            letter-spacing: 0.3px;
            font-family: inherit;
        }

        .btn-login:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 32px rgba(122, 12, 12, 0.45);
            background: linear-gradient(135deg, #8f0e0e, #b81a1a);
        }

        .btn-login:active {
            transform: translateY(0);
        }

        .btn-login i {
            font-size: 18px;
        }

        /* footer links */
        .form-footer {
            margin-top: 24px;
            text-align: center;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .form-footer a {
            color: #5a6f80;
            text-decoration: none;
            font-size: 14px;
            transition: all 0.2s ease;
            font-weight: 500;
        }

        .form-footer a:hover {
            color: #7a0c0c;
        }

        .form-footer .create-account {
            font-weight: 600;
            color: #7a0c0c;
            font-style: normal;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .form-footer .create-account i {
            font-size: 14px;
            transition: all 0.3s ease;
        }

        .form-footer .create-account:hover i {
            transform: translateX(4px);
        }

        .form-footer .divider {
            display: flex;
            align-items: center;
            gap: 16px;
            color: #98aec0;
            font-size: 13px;
            margin: 4px 0;
        }

        .form-footer .divider::before,
        .form-footer .divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: #dce3ea;
        }

        /* social login */
        .social-login {
            display: flex;
            gap: 12px;
            justify-content: center;
            margin-top: 4px;
        }

        .social-login a {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            border: 1px solid #dce3ea;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #5a6f80;
            transition: all 0.3s ease;
            text-decoration: none;
            font-size: 18px;
            background: white;
        }

        .social-login a:hover {
            border-color: #7a0c0c;
            color: #7a0c0c;
            transform: translateY(-3px);
            box-shadow: 0 4px 12px rgba(122, 12, 12, 0.15);
        }

        /* ----- RESPONSIVE ----- */
        @media (max-width: 900px) {
            .login-card {
                flex-direction: column;
                max-width: 500px;
            }

            .login-banner {
                min-height: 220px;
            }

            .banner-content {
                bottom: 24px;
                left: 24px;
            }

            .banner-content .brand {
                font-size: 22px;
            }

            .banner-content p {
                font-size: 13px;
            }

            .login-form-side {
                padding: 40px 32px;
            }

            .login-form-side .form-header h1 {
                font-size: 28px;
            }
        }

        @media (max-width: 480px) {
            .login-form-side {
                padding: 30px 20px;
            }

            .login-form-side .form-header h1 {
                font-size: 24px;
            }

            .btn-login {
                padding: 14px;
                font-size: 15px;
            }

            .banner-content .brand {
                font-size: 18px;
            }
        }

        /* subtle animation for form */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .login-form-side {
            animation: fadeInUp 0.6s ease forwards;
        }

        .login-banner {
            animation: fadeInUp 0.6s ease 0.1s backwards;
        }
    </style>
</head>
<body>

    <div class="login-page">
        <div class="login-card">

            <!-- LEFT BANNER – enhanced -->
            <div class="login-banner">
                <div class="banner-content">
                    <div class="badge">
                        <i class="fas fa-star" style="margin-right: 6px;"></i> premium
                    </div>
                    <div class="brand">
                        <i class="fas fa-bolt"></i>
                        SkillWap <span>Esprit</span>
                    </div>
                    <p>Level up your career with practical, career-focused programs in France</p>
                </div>
            </div>

            <!-- RIGHT FORM SIDE -->
            <div class="login-form-side">
                <div class="form-header">
                    <h1>Welcome Back</h1>
                    <p>Don't have an account? <a href="#">Sign up now</a></p>
                </div>

                <form method="post" action="#">
                    <div class="form-group">
                        <label for="name">Email or Username</label>
                        <div class="input-wrapper">
                            <i class="fas fa-user"></i>
                            <input type="text" id="name" name="Name" placeholder="Enter your email or username" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="password">Password</label>
                        <div class="input-wrapper">
                            <i class="fas fa-lock"></i>
                            <input type="password" id="password" name="password" placeholder="Enter your password" required>
                            <span class="toggle-password" onclick="togglePassword()">
                                <i class="fas fa-eye" id="eyeIcon"></i>
                            </span>
                        </div>
                    </div>

                    <button type="submit" class="btn-login">
                        <i class="fas fa-arrow-right"></i> Login
                    </button>
                </form>

                <div class="form-footer">
                    <div class="divider">or continue with</div>
                    <div class="social-login">
                        <a href="#"><i class="fab fa-google"></i></a>
                        <a href="#"><i class="fab fa-facebook-f"></i></a>
                        <a href="#"><i class="fab fa-github"></i></a>
                        <a href="#"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                    <a href="#" class="create-account">
                        <i class="fas fa-arrow-right"></i> Create an account
                    </a>
                </div>
            </div>

        </div>
    </div>

    <script>
        // Toggle password visibility
        function togglePassword() {
            const passwordInput = document.getElementById('password');
            const eyeIcon = document.getElementById('eyeIcon');
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                eyeIcon.className = 'fas fa-eye-slash';
            } else {
                passwordInput.type = 'password';
                eyeIcon.className = 'fas fa-eye';
            }
        }
    </script>

</body>
</html>